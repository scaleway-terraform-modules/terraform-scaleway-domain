variable "bimi" {
  type = object({
    logo_url          = string
    vmc_url           = optional(string)
    avatar_preference = optional(string, "brand")
    ttl               = optional(number)
  })
  description = "BIMI settings. When set, the module publishes a BIMI record (`default._bimi`) in the zone. `logo_url` is the URL of the logo, a SVG document following the [BIMI specifications](https://bimigroup.org/creating-bimi-svg-logo-files/). `vmc_url` is the URL of the Verified Mark Certificate or Common Mark Certificate. `avatar_preference` lets the domain owner prefer the BIMI logo (`brand`, the default) or the sender's personal avatar (`personal`) where both are supported. `ttl` sets the TTL of the record in seconds (provider default when unset). Logos are only displayed when DMARC is enforced: see the README for the requirements."
  default     = null

  validation {
    condition     = var.bimi == null ? true : startswith(var.bimi.logo_url, "https://")
    error_message = "'bimi.logo_url' must be an `https://` URL."
  }

  validation {
    condition     = var.bimi == null ? true : (var.bimi.vmc_url == null ? true : startswith(var.bimi.vmc_url, "https://"))
    error_message = "'bimi.vmc_url' must be an `https://` URL."
  }

  validation {
    condition     = var.bimi == null ? true : contains(["brand", "personal"], var.bimi.avatar_preference)
    error_message = "'bimi.avatar_preference' must be one of `brand` or `personal`."
  }

  validation {
    condition     = var.bimi == null || var.dmarc == null ? true : (var.dmarc.policy == "reject" || (var.dmarc.policy == "quarantine" && (var.dmarc.pct == null || var.dmarc.pct == 100))) && var.dmarc.subdomain_policy != "none"
    error_message = "'bimi' requires an enforced DMARC policy: set 'dmarc.policy' to `quarantine` (without a 'dmarc.pct' below 100) or `reject`, and don't set 'dmarc.subdomain_policy' to `none`."
  }

  validation {
    condition     = var.bimi == null ? true : (var.bimi.ttl == null ? true : var.bimi.ttl >= 1 && var.bimi.ttl <= 2147483647 && floor(var.bimi.ttl) == var.bimi.ttl)
    error_message = "'bimi.ttl' must be an integer between 1 and 2147483647 (seconds)."
  }
}

variable "dmarc" {
  type = object({
    policy           = optional(string, "none")
    subdomain_policy = optional(string)
    pct              = optional(number)
    rua              = optional(list(string), [])
    ruf              = optional(list(string), [])
    ttl              = optional(number)
  })
  description = "DMARC policy to publish for the domain. When set, the module publishes its own DMARC record built from these settings, with or without Transactional Email: `policy` (`none`, `quarantine` or `reject`, default `none`), `subdomain_policy` (`sp=`), `pct` (percentage of messages the policy applies to), `rua` / `ruf` (email addresses receiving aggregate and failure reports), and `ttl` (TTL of the record in seconds, provider default when unset). When null, the module publishes the DMARC record generated by Transactional Email if `tem` is set, and none otherwise."
  default     = null

  validation {
    condition     = var.dmarc == null ? true : contains(["none", "quarantine", "reject"], var.dmarc.policy) && (var.dmarc.subdomain_policy == null ? true : contains(["none", "quarantine", "reject"], var.dmarc.subdomain_policy))
    error_message = "'dmarc.policy' and 'dmarc.subdomain_policy' must be one of `none`, `quarantine` or `reject`."
  }

  validation {
    condition     = var.dmarc == null ? true : (var.dmarc.pct == null ? true : var.dmarc.pct >= 0 && var.dmarc.pct <= 100 && floor(var.dmarc.pct) == var.dmarc.pct)
    error_message = "'dmarc.pct' must be an integer between 0 and 100."
  }

  validation {
    condition     = var.dmarc == null ? true : alltrue([for address in concat(var.dmarc.rua, var.dmarc.ruf) : !startswith(lower(address), "mailto:") && can(regex("^[^@[:space:],;!]+@[^@[:space:],;!]+\\.[^@[:space:],;!]+$", address))])
    error_message = "'dmarc.rua' and 'dmarc.ruf' must contain email addresses, e.g. `dmarc-reports@example.net`, without the `mailto:` prefix."
  }

  validation {
    condition     = var.dmarc == null ? true : (var.dmarc.ttl == null ? true : var.dmarc.ttl >= 1 && var.dmarc.ttl <= 2147483647 && floor(var.dmarc.ttl) == var.dmarc.ttl)
    error_message = "'dmarc.ttl' must be an integer between 1 and 2147483647 (seconds)."
  }
}

variable "domain" {
  type        = string
  description = "Name of the domain to manage."
}

variable "mx_servers" {
  type = object({
    servers = list(object({
      address  = string
      priority = number
    }))
    ttl = optional(number)
  })
  description = "MX servers of the domain. `servers` lists their `address` and `priority`, and `ttl` sets the TTL in seconds of all MX records, as DNS expects records sharing a name and type to share their TTL (provider default when unset). **MX servers are required to enable Transactional Email.** The default points to Scaleway's blackhole server, which rejects all incoming mail, and is created even when `tem` is not set. Set your own servers, or `servers = []` to manage MX records outside of this module. End external host names with a dot (e.g. `mx.example.com.`), as names without it may be relative to the zone."
  default = {
    servers = [{
      address  = "blackhole.scw-tem.cloud."
      priority = 10
    }]
  }
  nullable = false

  validation {
    condition     = alltrue([for server in var.mx_servers.servers : server.priority >= 0 && server.priority <= 65535 && floor(server.priority) == server.priority])
    error_message = "'mx_servers.servers[].priority' must be an integer between 0 and 65535."
  }

  validation {
    condition     = alltrue([for server in var.mx_servers.servers : can(regex("^(?i)([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]*[a-z0-9])?\\.?$", server.address))])
    error_message = "'mx_servers.servers[].address' must be a valid host name, e.g. `mx.example.net.`."
  }

  validation {
    condition     = var.mx_servers == null ? true : (var.mx_servers.ttl == null ? true : var.mx_servers.ttl >= 1 && var.mx_servers.ttl <= 2147483647 && floor(var.mx_servers.ttl) == var.mx_servers.ttl)
    error_message = "'mx_servers.ttl' must be an integer between 1 and 2147483647 (seconds)."
  }

  validation {
    condition     = length(distinct([for server in var.mx_servers.servers : server.address])) == length(var.mx_servers.servers)
    error_message = "'mx_servers.servers[].address' values must be unique."
  }
}

variable "project_id" {
  type        = string
  description = "ID of the project the domain is associated with. Resource will be created in the project set at the provider level if null."
  default     = null
}

variable "spf" {
  type = object({
    mechanisms = optional(list(string), [])
    all        = optional(string, "-all")
    ttl        = optional(number)
  })
  description = "Settings of the SPF record published with Transactional Email. `mechanisms` lists additional SPF mechanisms authorising other services to send mail for the domain, e.g. `include:_spf.google.com` or `ip4:192.0.2.1`, inserted before the final `all`. `all` sets how receivers treat other senders: `-all` (fail, the default), `~all` (softfail) or `?all` (neutral). `ttl` sets the TTL of the record in seconds (provider default when unset). Requires `tem`."
  default     = null

  validation {
    condition     = alltrue([for mechanism in try(var.spf.mechanisms, []) : can(regex("^[-+?~]?((a|mx)([:/][^[:space:]]+)?|ptr(:[^[:space:]]+)?|(include|exists|ip4|ip6):[^[:space:]]+)$", mechanism))])
    error_message = "'spf.mechanisms' values must be single SPF mechanisms (`a`, `mx`, `ptr`, `include:`, `exists:`, `ip4:` or `ip6:`, with an optional qualifier), without spaces. Use 'spf.all' to set the final `all`."
  }

  validation {
    condition     = contains(["-all", "~all", "?all"], try(var.spf.all, "-all"))
    error_message = "'spf.all' must be one of `-all`, `~all` or `?all`."
  }

  validation {
    condition     = var.spf == null || var.tem != null
    error_message = "'spf' requires 'tem' to be set: the module only publishes an SPF record with Transactional Email."
  }

  validation {
    condition     = var.spf == null ? true : (var.spf.ttl == null ? true : var.spf.ttl >= 1 && var.spf.ttl <= 2147483647 && floor(var.spf.ttl) == var.spf.ttl)
    error_message = "'spf.ttl' must be an integer between 1 and 2147483647 (seconds)."
  }
}

variable "subdomain" {
  type        = string
  description = "Name of the subdomain to manage."
  default     = ""

  validation {
    condition     = var.subdomain == "" || can(regex("^(?i)([a-z0-9_]([a-z0-9_-]*[a-z0-9])?\\.)*[a-z0-9_]([a-z0-9_-]*[a-z0-9])?$", var.subdomain))
    error_message = "'subdomain' must be a valid DNS name relative to 'domain', without a trailing dot, e.g. `contact`."
  }

  validation {
    condition     = !endswith(lower(var.subdomain), lower(".${var.domain}"))
    error_message = "'subdomain' must not include the parent domain: use e.g. `contact`, not `contact.example.net`."
  }
}

variable "tem" {
  type = object({
    accept_tos = bool
  })
  description = "Transactional Email settings. When set, the module sets up Transactional Email for the domain: it creates the Transactional Email domain, publishes its DKIM, SPF and DMARC records, and waits for Scaleway to validate it. `accept_tos` must be `true`: it accepts Scaleway's [Transactional Email terms of service](https://www.scaleway.com/en/contracts/), including its [anti-spam policy](https://tem.s3.fr-par.scw.cloud/antispam_policy.pdf), on behalf of the account running Terraform. Transactional Email is only available in region `fr-par`: the module always creates it there, whatever the provider's region."
  default     = null

  validation {
    condition     = var.tem == null ? true : var.tem.accept_tos
    error_message = "'tem.accept_tos' must be true: Scaleway requires accepting the Transactional Email terms of service (https://www.scaleway.com/en/contracts/) to set it up."
  }
}
